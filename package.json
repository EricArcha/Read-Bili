{
  "name": "read-bili",
  "version": "1.2.1",
  "description": "Bilibili video transcription & summarization tool — download audio, transcribe via SiliconFlow ASR, and output readable transcripts.",
  "type": "module",
  "main": "src/cli.mjs",
  "bin": {
    "read-bili": "./src/cli.mjs"
  },
  "files": [
    "src/",
    "docs/",
    "SKILL.md",
    "package-lock.json",
    "npm-shrinkwrap.json",
    "install.ps1",
    "configure-api-key.ps1",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "test:package": "node scripts/package-smoke.mjs",
    "doctor": "node src/cli.mjs doctor",
    "setup": "node src/cli.mjs setup"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.0"
  },
  "keywords": [
    "bilibili",
    "transcription",
    "asr",
    "subtitles",
    "video"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EricArcha/Read-Bili.git"
  },
  "bugs": {
    "url": "https://github.com/EricArcha/Read-Bili/issues"
  },
  "homepage": "https://github.com/EricArcha/Read-Bili#readme"
}
